+/**
+ * Shot presets: tap a saved framing and the gimbal travels there over the chosen time. The
+ * joystick and zoom stay usable behind the panel, so the operator frames first, then saves.
+ */
+@Composable
+private fun LiveGimbalShots(model: GimbalChromeHost, running: Boolean, maxWidthDp: Float, maxHeightDp: Float) {
+    val presets by model.gimbalShotPresets.collectAsState()
+    val travel by model.shotTravelSeconds.collectAsState()
+    var editing by remember { mutableStateOf<String?>(null) }
+    var renaming by remember { mutableStateOf<String?>(null) }
+    var draft by remember { mutableStateOf("") }
+    val scroll = rememberScrollState()
+    val full = presets.size >= GimbalShotPresets.MAX_PRESETS
+    Column(
+        Modifier
+            .width(min(EDITOR_WIDTH_DP, maxWidthDp).dp)
+            .height(min(EDITOR_HEIGHT_DP, maxHeightDp).dp)
+            .testTag("shots.panel")
+            .monitorMaterial(MonitorMaterial.Expanded, RoundedCornerShape(16.dp)),
+    ) {
+        Row(Modifier.fillMaxWidth().height(48.dp).padding(horizontal = 12.dp),
+            verticalAlignment = Alignment.CenterVertically) {
+            Text("SHOTS", color = LiveDesign.text,
+                style = LiveType.ui(9f, FontWeight.SemiBold).copy(letterSpacing = 1.6.sp),
+                modifier = Modifier.weight(1f))
+            LivePopupCloseButton(
+                onClick = { model.liveGimbalPanel = LiveGimbalPanel.NONE },
+                size = 30.dp,
+                modifier = Modifier.testTag("shots.close"),
+            )
+        }
+        Column(
+            Modifier.weight(1f).fillMaxWidth()
+                .monitorScrollFade(scroll)
+                .verticalScroll(scroll)
+                .padding(horizontal = 12.dp, vertical = 4.dp),
+            verticalArrangement = Arrangement.spacedBy(7.dp),
+        ) {
+            if (presets.isEmpty()) {
+                Text("Frame the shot with the joystick and zoom, then tap Save. Keep the camera on a fixed " +
+                    "mount: shots are relative to the handle.",
+                    color = LiveDesign.secondary, style = LiveType.ui(10.5f),
+                    modifier = Modifier.padding(vertical = 8.dp))
+            }
+            presets.forEachIndexed { index, preset ->
+                key(preset.id) {
+                    MonitorOptionGroup {
+                        Row(verticalAlignment = Alignment.CenterVertically,
+                            horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                            Box(Modifier.size(24.dp).background(LiveDesign.accentDim, CircleShape),
+                                contentAlignment = Alignment.Center) {
+                                Text("${index + 1}", color = LiveDesign.accent, style = LiveType.ui(10f, FontWeight.Bold))
+                            }
+                            Column(
+                                Modifier.weight(1f).heightIn(min = 44.dp)
+                                    .testTag("shots.recall.${index + 1}")
+                                    .chromeClickable(onClick = {
+                                        editing = null
+                                        model.recallGimbalShotPreset(preset.id)
+                                    })
+                                    .semantics {
+                                        contentDescription = "Go to ${preset.name}"
+                                        role = Role.Button
+                                    },
+                                verticalArrangement = Arrangement.Center,
+                            ) {
+                                Text(preset.name, color = LiveDesign.text, maxLines = 1,
+                                    style = LiveType.ui(13f, FontWeight.SemiBold))
+                                Text(preset.readout, color = LiveDesign.muted, maxLines = 1,
+                                    style = LiveType.ui(9f, FontWeight.Medium))
+                            }
+                            Box(Modifier.size(44.dp)
+                                .testTag("shots.more.${index + 1}")
+                                .chromeClickable(onClick = {
+                                    editing = if (editing == preset.id) null else preset.id
+                                    renaming = null
+                                }),
+                                contentAlignment = Alignment.Center) {
+                                MonitorIcon(MonitorIcon.ELLIPSIS, contentDescription = "Edit ${preset.name}",
+                                    modifier = Modifier.size(15.dp), tint = LiveDesign.text)
+                            }
+                        }
+                        if (editing == preset.id) {
+                            if (renaming == preset.id) {
+                                Row(Modifier.fillMaxWidth().padding(bottom = 7.dp),
+                                    verticalAlignment = Alignment.CenterVertically,
+                                    horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                                    BasicTextField(
+                                        value = draft,
+                                        onValueChange = { draft = it.take(GimbalShotPresets.MAX_NAME_LENGTH) },
+                                        singleLine = true,
+                                        textStyle = LiveType.ui(13f).copy(color = LiveDesign.text),
+                                        cursorBrush = SolidColor(LiveDesign.accent),
+                                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),
+                                        keyboardActions = KeyboardActions(onDone = {
+                                            model.renameGimbalShotPreset(preset.id, draft)
+                                            renaming = null
+                                        }),
+                                        modifier = Modifier.weight(1f)
+                                            .background(LiveDesign.glassBright, RoundedCornerShape(8.dp))
+                                            .padding(horizontal = 10.dp, vertical = 10.dp)
+                                            .testTag("shots.name"),
+                                    )
+                                    Chip("OK", selected = true, compact = true) {
+                                        model.renameGimbalShotPreset(preset.id, draft)
+                                        renaming = null
+                                    }
+                                }
+                            } else {
+                                Row(Modifier.fillMaxWidth().padding(bottom = 7.dp),
+                                    horizontalArrangement = Arrangement.spacedBy(6.dp),
+                                    verticalAlignment = Alignment.CenterVertically) {
+                                    Chip("Update", selected = false, compact = true, enabled = !running) {
+                                        model.updateGimbalShotPreset(preset.id)
+                                    }
+                                    Chip("Rename", selected = false, compact = true) {
+                                        draft = preset.name
+                                        renaming = preset.id
+                                    }
+                                    Spacer(Modifier.weight(1f))
+                                    Box(Modifier.size(36.dp).chromeClickable(enabled = index > 0,
+                                        onClick = { model.moveGimbalShotPreset(preset.id, -1) }),
+                                        contentAlignment = Alignment.Center) {
+                                        MonitorIcon(MonitorIcon.CHEVRON_UP, contentDescription = "Move up",
+                                            modifier = Modifier.size(14.dp).alpha(if (index > 0) 1f else .35f),
+                                            tint = LiveDesign.text)
+                                    }
+                                    Box(Modifier.size(36.dp).chromeClickable(enabled = index < presets.lastIndex,
+                                        onClick = { model.moveGimbalShotPreset(preset.id, 1) }),
+                                        contentAlignment = Alignment.Center) {
+                                        MonitorIcon(MonitorIcon.CHEVRON_DOWN, contentDescription = "Move down",
+                                            modifier = Modifier.size(14.dp).alpha(if (index < presets.lastIndex) 1f else .35f),
+                                            tint = LiveDesign.text)
+                                    }
+                                    Box(Modifier.size(36.dp).chromeClickable(onClick = {
+                                        editing = null
+                                        model.deleteGimbalShotPreset(preset.id)
+                                    }), contentAlignment = Alignment.Center) {
+                                        MonitorIcon(MonitorIcon.TRASH, contentDescription = "Delete ${preset.name}",
+                                            modifier = Modifier.size(14.dp), tint = LiveDesign.destructive)
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Row(Modifier.fillMaxWidth().padding(horizontal = 12.dp, vertical = 4.dp),
+            verticalAlignment = Alignment.CenterVertically) {
+            Text("Travel time", color = LiveDesign.muted, style = LiveType.ui(10f, FontWeight.SemiBold),
+                modifier = Modifier.weight(1f))
+            val stops = GimbalShotPresets.travelStops
+            val current = stops.indexOfFirst { it >= travel - 1e-6 }.let { if (it < 0) stops.lastIndex else it }
+            Box(Modifier.size(36.dp).testTag("shots.travel.minus")
+                .chromeClickable(enabled = current > 0, onClick = { model.setShotTravelSeconds(stops[current - 1]) }),
+                contentAlignment = Alignment.Center) {
+                Text("−", color = LiveDesign.text, style = LiveType.ui(16f, FontWeight.Bold))
+            }
+            Text(GimbalProgram.durationLabel(travel), color = LiveDesign.text,
+                style = LiveType.mono(13f, FontWeight.SemiBold), modifier = Modifier.widthIn(min = 40.dp))
+            Box(Modifier.size(36.dp).testTag("shots.travel.plus")
+                .chromeClickable(enabled = current < stops.lastIndex, onClick = { model.setShotTravelSeconds(stops[current + 1]) }),
+                contentAlignment = Alignment.Center) {
+                Text("+", color = LiveDesign.text, style = LiveType.ui(16f, FontWeight.Bold))
+            }
+        }
+        Row(Modifier.fillMaxWidth().padding(horizontal = 12.dp, vertical = 10.dp),
+            horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            if (running) {
+                Chip("Stop", selected = true, modifier = Modifier.weight(1f).height(44.dp).testTag("shots.stop")) {
+                    model.cancelProgrammedMove()
+                }
+            } else {
+                Chip(if (full) "Limit reached" else "Save current framing", selected = !full,
+                    enabled = !full, modifier = Modifier.weight(1f).height(44.dp).testTag("shots.save")) {
+                    model.saveGimbalShotPreset()
+                }
+            }
+        }
+    }
+}
