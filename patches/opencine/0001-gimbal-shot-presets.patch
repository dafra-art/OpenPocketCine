+package com.opencapture.opencine.dji
+
+import com.opencapture.opencine.motion.GimbalProgram
+import com.opencapture.opencine.motion.GimbalWaypoint
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertTrue
+
+/** Shot preset recall: a program from the live pose with a short settle instead of the 2 s take hold. */
+class GimbalShotPresetEngineTest {
+    private val live = GimbalWaypoint(0.0, 0.0, 1.0, nativePitchDeg = 0.0)
+    private val shot = GimbalWaypoint(40.0, 10.0, 1.0, nativePitchDeg = -10.0)
+
+    private fun firstTargetTime(hold: Double): Double {
+        val engine = GimbalMoveEngine()
+        assertTrue(engine.start(GimbalProgram(a = live, b = shot, durationAB = 3.0, holdSeconds = hold), live))
+        var t = 0.0
+        while (t < 3.0) {
+            val out = engine.tick(0.04, live)
+            t += 0.04
+            if (out?.target != null) return t
+        }
+        error("no target")
+    }
+
+    @Test
+    fun presetHoldStartsTheMoveSoonerThanATake() {
+        val preset = firstTargetTime(PocketCameraSession.PRESET_HOLD_SECONDS)
+        val take = firstTargetTime(GimbalProgram.DEFAULT_HOLD_SECONDS)
+        assertTrue(preset < 0.5, "preset $preset")
+        assertTrue(take >= GimbalProgram.DEFAULT_HOLD_SECONDS, "take $take")
+    }
+
+    @Test
+    fun defaultHoldIsUnchanged() {
+        assertEquals(2.0, GimbalMoveEngine.HOLD_SECONDS)
+        assertEquals(2.0, GimbalProgram().holdSeconds)
+    }
+
+    @Test
+    fun invalidHoldIsRejected() {
+        assertFalse(GimbalMoveEngine().start(GimbalProgram(a = live, b = shot, holdSeconds = Double.NaN), live))
+        assertFalse(GimbalMoveEngine().start(GimbalProgram(a = live, b = shot, holdSeconds = -1.0), live))
+        assertNotNull(GimbalMoveEngine().takeIf { it.start(GimbalProgram(a = live, b = shot, holdSeconds = 0.0), live) })
+    }
+}
