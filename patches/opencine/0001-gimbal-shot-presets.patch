+package com.opencapture.opencine.cameracontrols
+
+import com.opencapture.opencine.motion.GimbalWaypoint
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+class GimbalShotPresetsTest {
+    private fun preset(id: String, name: String = "Shot $id", yaw: Double = 10.0) =
+        GimbalShotPreset(id, name, GimbalWaypoint(yaw, -5.5, 2.0, -12.25))
+
+    @Test
+    fun roundTripKeepsEveryField() {
+        val list = listOf(preset("a", "Palco"), GimbalShotPreset("b", "Pubblico", GimbalWaypoint(-40.0, 12.0, 1.0, null)))
+        assertEquals(list, GimbalShotPresets.decode(GimbalShotPresets.encode(list)))
+    }
+
+    @Test
+    fun namesCannotBreakTheLineFormat() {
+        val list = listOf(preset("a", "Pal\tco\nnuovo"))
+        val decoded = GimbalShotPresets.decode(GimbalShotPresets.encode(list))
+        assertEquals("Pal co nuovo", decoded.single().name)
+    }
+
+    @Test
+    fun corruptOrForeignTextIsIgnored() {
+        assertTrue(GimbalShotPresets.decode(null).isEmpty())
+        assertTrue(GimbalShotPresets.decode("garbage").isEmpty())
+        val text = "v1\na\tOk\t1\t2\t1\t\nb\tBad\tx\t2\t1\t\nc\tNaN\tNaN\t2\t1\t\n"
+        assertEquals(listOf("a"), GimbalShotPresets.decode(text).map { it.id })
+    }
+
+    @Test
+    fun addStopsAtTheLimit() {
+        var list = emptyList<GimbalShotPreset>()
+        repeat(GimbalShotPresets.MAX_PRESETS) { list = GimbalShotPresets.add(list, preset("$it"))!! }
+        assertNull(GimbalShotPresets.add(list, preset("x")))
+    }
+
+    @Test
+    fun defaultNamesFillGaps() {
+        assertEquals("Shot 1", GimbalShotPresets.nextDefaultName(emptyList()))
+        assertEquals("Shot 2", GimbalShotPresets.nextDefaultName(listOf(preset("1", "Shot 1"), preset("3", "Shot 3"))))
+    }
+
+    @Test
+    fun renameReplaceRemoveAndMove() {
+        val list = listOf(preset("a"), preset("b"), preset("c"))
+        assertEquals("Palco", GimbalShotPresets.rename(list, "b", "  Palco ")[1].name)
+        assertEquals(list, GimbalShotPresets.rename(list, "b", "   "))
+        assertEquals(99.0, GimbalShotPresets.replacePose(list, "c", GimbalWaypoint(99.0, 0.0, 1.0))[2].pose.yawDeg)
+        assertEquals(listOf("a", "c"), GimbalShotPresets.remove(list, "b").map { it.id })
+        assertEquals(listOf("b", "a", "c"), GimbalShotPresets.move(list, "b", -1).map { it.id })
+        assertEquals(list, GimbalShotPresets.move(list, "c", 1))
+    }
+}
