+package com.opencapture.opencine.cameracontrols
+
+import com.opencapture.opencine.motion.GimbalWaypoint
+import java.util.Locale
+
+/**
+ * One saved framing: pan, tilt and zoom the operator can recall with a tap. Angles are the
+ * gimbal's joint angles, so a shot stays valid only while the handle has not moved.
+ */
+data class GimbalShotPreset(
+    val id: String,
+    val name: String,
+    val pose: GimbalWaypoint,
+) {
+    val readout: String
+        get() = String.format(Locale.US, "PAN %+.0f°  TILT %+.0f°  %.1f×", pose.yawDeg, pose.pitchDeg, pose.zoom)
+}
+
+/** Pure list rules and a line codec for shot presets; storage is the app's. */
+object GimbalShotPresets {
+    const val MAX_PRESETS: Int = 12
+    const val MAX_NAME_LENGTH: Int = 24
+    const val DEFAULT_TRAVEL_SECONDS: Double = 3.0
+    val travelStops: List<Double> = listOf(1.0, 2.0, 3.0, 5.0, 8.0, 12.0, 20.0)
+
+    private const val VERSION = "v1"
+
+    fun cleanName(raw: String): String =
+        raw.replace(Regex("[\\t\\r\\n]"), " ").trim().take(MAX_NAME_LENGTH)
+
+    /** "Shot N" with the lowest N not already used. */
+    fun nextDefaultName(presets: List<GimbalShotPreset>): String {
+        val used = presets.map { it.name }.toSet()
+        var n = 1
+        while ("Shot $n" in used) n += 1
+        return "Shot $n"
+    }
+
+    fun add(presets: List<GimbalShotPreset>, preset: GimbalShotPreset): List<GimbalShotPreset>? =
+        if (presets.size >= MAX_PRESETS) null else presets + preset
+
+    fun replacePose(presets: List<GimbalShotPreset>, id: String, pose: GimbalWaypoint): List<GimbalShotPreset> =
+        presets.map { if (it.id == id) it.copy(pose = pose) else it }
+
+    fun rename(presets: List<GimbalShotPreset>, id: String, name: String): List<GimbalShotPreset> {
+        val clean = cleanName(name)
+        if (clean.isEmpty()) return presets
+        return presets.map { if (it.id == id) it.copy(name = clean) else it }
+    }
+
+    fun remove(presets: List<GimbalShotPreset>, id: String): List<GimbalShotPreset> = presets.filterNot { it.id == id }
+
+    fun move(presets: List<GimbalShotPreset>, id: String, delta: Int): List<GimbalShotPreset> {
+        val from = presets.indexOfFirst { it.id == id }
+        if (from < 0) return presets
+        val to = (from + delta).coerceIn(0, presets.lastIndex)
+        if (to == from) return presets
+        return presets.toMutableList().apply { add(to, removeAt(from)) }
+    }
+
+    fun encode(presets: List<GimbalShotPreset>): String = buildString {
+        append(VERSION).append('\n')
+        for (p in presets) {
+            append(listOf(
+                p.id, cleanName(p.name), p.pose.yawDeg.toString(), p.pose.pitchDeg.toString(),
+                p.pose.zoom.toString(), p.pose.nativePitchDeg?.toString() ?: "",
+            ).joinToString("\t")).append('\n')
+        }
+    }
+
+    /** Unreadable lines are dropped rather than failing the whole list. */
+    fun decode(text: String?): List<GimbalShotPreset> {
+        if (text.isNullOrBlank()) return emptyList()
+        val lines = text.split('\n')
+        if (lines.firstOrNull()?.trim() != VERSION) return emptyList()
+        return lines.drop(1).mapNotNull { line ->
+            val f = line.split('\t')
+            if (f.size < 6) return@mapNotNull null
+            val yaw = f[2].toDoubleOrNull() ?: return@mapNotNull null
+            val pitch = f[3].toDoubleOrNull() ?: return@mapNotNull null
+            val zoom = f[4].toDoubleOrNull() ?: return@mapNotNull null
+            val native = if (f[5].isEmpty()) null else (f[5].toDoubleOrNull() ?: return@mapNotNull null)
+            if (!yaw.isFinite() || !pitch.isFinite() || !zoom.isFinite() || native?.isFinite() == false) return@mapNotNull null
+            val name = cleanName(f[1]).ifEmpty { return@mapNotNull null }
+            if (f[0].isBlank()) return@mapNotNull null
+            GimbalShotPreset(f[0], name, GimbalWaypoint(yaw, pitch, zoom, native))
+        }.distinctBy { it.id }.take(MAX_PRESETS)
+    }
+}
