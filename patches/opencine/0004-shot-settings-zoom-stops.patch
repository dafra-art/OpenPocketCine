 @Composable
 private fun rememberFeedGestureState(): FeedGestureState = remember { FeedGestureState() }
+
+/** The fixed zoom buttons beside the gimbal stick, in place of the cycling chip. */
+object LiveZoomStopButtons {
+    val STOPS: List<Double> = listOf(1.0, 3.0, 6.0)
+    const val GAP: Float = 4f
+
+    /** Stops this lens can reach; 1× always stays. */
+    fun reachable(maximum: Double): List<Double> = STOPS.filter { it <= 1.0 || it <= maximum + 1e-6 }
+
+    /** The stop the lens is at, within the chip's jitter tolerance, else null. */
+    fun active(factor: Double, stops: List<Double>): Double? =
+        stops.firstOrNull { kotlin.math.abs(it - factor) < 0.15 }
+
+    /** A row ending at the chip's trailing edge, one chip-height button per stop. */
+    fun frame(chip: MonitorRect, count: Int, minX: Float): MonitorRect {
+        val size = chip.height
+        val width = count * size + (count - 1).coerceAtLeast(0) * GAP
+        val x = max(minX, chip.maxX - width)
+        return MonitorRect(x, chip.y, width, size)
+    }
+
+    fun label(stop: Double): String = if (stop % 1.0 == 0.0) "${stop.toInt()}×" else "$stop×"
+}
+
+@Composable
+fun LiveZoomStopRow(
+    factor: Double,
+    stops: List<Double>,
+    locked: Boolean,
+    dimmed: Boolean,
+    onSelect: (Double) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val haptics = LocalOperatorHaptics.current
+    val active = LiveZoomStopButtons.active(factor, stops)
+    Row(modifier.testTag("live.zoom.stops").alpha(if (locked || dimmed) .4f else 1f),
+        horizontalArrangement = Arrangement.spacedBy(LiveZoomStopButtons.GAP.dp)) {
+        for (stop in stops) {
+            val selected = stop == active
+            Box(
+                Modifier.weight(1f).fillMaxHeight()
+                    .monitorGlass(CircleShape)
+                    .then(if (selected) Modifier.background(LiveDesign.accent, CircleShape) else Modifier)
+                    .testTag("live.zoom.${LiveZoomStopButtons.label(stop)}")
+                    .chromeClickable(enabled = !locked, onClick = { haptics.selection(); onSelect(stop) })
+                    .semantics {
+                        contentDescription = "Zoom ${LiveZoomStopButtons.label(stop)}"
+                        role = Role.Button
+                    },
+                contentAlignment = Alignment.Center,
+            ) {
+                Text(LiveZoomStopButtons.label(stop),
+                    color = if (selected) LiveDesign.background else LiveDesign.text,
+                    style = LiveType.ui(12f, FontWeight.Bold))
+            }
+        }
+    }
+}
