+
+    @Test
+    fun settingsRoundTripAndOldLinesStillLoad() {
+        val settings = mapOf("expo" to 4, "iso" to 3, "shutter" to 50, "kelvin" to 5600, "fx" to 5000)
+        val list = listOf(GimbalShotPreset("a", "Palco", GimbalWaypoint(1.0, 2.0, 3.0, 4.0), settings))
+        assertEquals(list, GimbalShotPresets.decode(GimbalShotPresets.encode(list)))
+        val old = "v1\na\tOld\t1\t2\t1\t\n"
+        assertEquals(emptyMap<String, Int>(), GimbalShotPresets.decode(old).single().settings)
+        assertEquals(mapOf("ok" to 1), GimbalShotPresets.decodeSettings("ok=1,bad,x=y,=3,9no=2"))
+    }
+
+    @Test
+    fun updateKeepsSettingsUnlessGiven() {
+        val list = listOf(GimbalShotPreset("a", "A", GimbalWaypoint(0.0, 0.0, 1.0), mapOf("iso" to 1)))
+        val pose = GimbalWaypoint(5.0, 0.0, 1.0)
+        assertEquals(mapOf("iso" to 1), GimbalShotPresets.replacePose(list, "a", pose).single().settings)
+        assertEquals(mapOf("iso" to 2), GimbalShotPresets.replacePose(list, "a", pose, mapOf("iso" to 2)).single().settings)
+    }
