+        get() = String.format(Locale.US, "PAN %+.0f°  TILT %+.0f°  %.1f×", pose.yawDeg, pose.pitchDeg, pose.zoom) +
+            if (settings.isEmpty()) "" else "  · SETTINGS"
 }
 
 /** Pure list rules and a line codec for shot presets; storage is the app's. */
@@ -39,8 +45,25 @@ object GimbalShotPresets {
     fun add(presets: List<GimbalShotPreset>, preset: GimbalShotPreset): List<GimbalShotPreset>? =
         if (presets.size >= MAX_PRESETS) null else presets + preset
 
-    fun replacePose(presets: List<GimbalShotPreset>, id: String, pose: GimbalWaypoint): List<GimbalShotPreset> =
-        presets.map { if (it.id == id) it.copy(pose = pose) else it }
+    fun replacePose(presets: List<GimbalShotPreset>, id: String, pose: GimbalWaypoint,
+        settings: Map<String, Int>? = null): List<GimbalShotPreset> =
+        presets.map { if (it.id == id) it.copy(pose = pose, settings = settings ?: it.settings) else it }
+
+    private val settingKey = Regex("[A-Za-z][A-Za-z0-9]{0,15}")
+
+    fun encodeSettings(settings: Map<String, Int>): String =
+        settings.filterKeys { settingKey.matches(it) }.entries.sortedBy { it.key }.joinToString(",") { "${it.key}=${it.value}" }
+
+    fun decodeSettings(text: String?): Map<String, Int> {
+        if (text.isNullOrBlank()) return emptyMap()
+        return text.split(',').mapNotNull { part ->
+            val eq = part.indexOf('=')
+            if (eq <= 0) return@mapNotNull null
+            val key = part.substring(0, eq)
+            val value = part.substring(eq + 1).toIntOrNull() ?: return@mapNotNull null
+            if (settingKey.matches(key)) key to value else null
+        }.toMap()
+    }
 
     fun rename(presets: List<GimbalShotPreset>, id: String, name: String): List<GimbalShotPreset> {
         val clean = cleanName(name)
@@ -63,7 +86,7 @@ object GimbalShotPresets {
