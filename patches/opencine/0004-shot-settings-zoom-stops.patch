+package com.opencapture.opencine.cameracontrols
+
+import com.opencapture.monitorui.MonitorRect
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+class LiveZoomStopButtonsTest {
+    @Test
+    fun stopsFollowTheLens() {
+        assertEquals(listOf(1.0, 3.0, 6.0), LiveZoomStopButtons.reachable(12.0))
+        assertEquals(listOf(1.0, 3.0), LiveZoomStopButtons.reachable(4.0))
+        assertEquals(listOf(1.0), LiveZoomStopButtons.reachable(1.0))
+    }
+
+    @Test
+    fun activeStopToleratesJitter() {
+        val stops = LiveZoomStopButtons.STOPS
+        assertEquals(3.0, LiveZoomStopButtons.active(3.08, stops))
+        assertNull(LiveZoomStopButtons.active(4.5, stops))
+    }
+
+    @Test
+    fun rowEndsAtTheChipAndStaysOnScreen() {
+        val row = LiveZoomStopButtons.frame(MonitorRect(300f, 500f, 44f, 44f), 3, 8f)
+        assertEquals(344f, row.maxX)
+        assertEquals(3 * 44f + 2 * LiveZoomStopButtons.GAP, row.width)
+        assertEquals(8f, LiveZoomStopButtons.frame(MonitorRect(20f, 0f, 44f, 44f), 3, 8f).x)
+        assertEquals("6×", LiveZoomStopButtons.label(6.0))
+    }
+}
