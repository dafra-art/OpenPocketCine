 /**
- * One-tap shot buttons on the live screen: a column against the picture's trailing edge, below
- * the top status deck and above the trailing gimbal cluster. Hidden until a shot is saved.
+ * Where the one-tap shot column goes: against the leading edge, below whatever sits at the
+ * top-left (lock, battery, status deck) and above the first control beneath it. Item height is
+ * chosen so [SHOT_RAIL_VISIBLE] buttons fit, in portrait and landscape alike.
  */
+data class ShotRailFrame(val x: Float, val top: Float, val width: Float, val height: Float, val itemHeight: Float) {
+    val showsName: Boolean get() = itemHeight >= 40f
+}
+
+const val SHOT_RAIL_VISIBLE: Int = 6
+private const val SHOT_RAIL_GAP = 4f
+private const val SHOT_RAIL_MIN_ITEM = 28f
+private const val SHOT_RAIL_MAX_ITEM = 44f
+
+fun shotRailFrame(layout: LiveMonitorLayout, cluster: GimbalCluster): ShotRailFrame? {
+    val portrait = layout.viewportHeight > layout.viewportWidth
+    val feed = layout.onFeed
+    val leading = max(8f, layout.safeLeading + 8f)
+    val x = if (portrait) leading else max(leading, feed.minX + 8f)
+    val width = 44f
+    fun overlapsColumn(r: MonitorRect) = !r.isEmpty && r.maxX > x && r.minX < x + width
+    val topBlockers = listOf(layout.lock, layout.battery, layout.topDeck).filter(::overlapsColumn)
+    val top = max(layout.safeTop + 8f, max(if (portrait) 0f else feed.minY, topBlockers.maxOfOrNull { it.maxY } ?: 0f)) + 6f
+    val bottomLimit = min(layout.viewportHeight - layout.safeBottom - 8f, if (portrait) Float.MAX_VALUE else feed.maxY - 6f)
+    val obstacles = listOf(layout.assist, layout.capture, layout.rail, layout.settings, layout.media, layout.record,
+        layout.disp, cluster.stick, cluster.zoom, cluster.controls, cluster.headTrack, layout.focusReset, layout.aeUnlock)
+        .filter { overlapsColumn(it) && it.minY > top + SHOT_RAIL_MIN_ITEM }
+    val floor = min(bottomLimit, (obstacles.minOfOrNull { it.minY } ?: Float.MAX_VALUE) - 6f)
+    val available = floor - top
+    val item = ((available - (SHOT_RAIL_VISIBLE - 1) * SHOT_RAIL_GAP) / SHOT_RAIL_VISIBLE)
+        .coerceIn(SHOT_RAIL_MIN_ITEM, SHOT_RAIL_MAX_ITEM)
+    if (available < item) return null
+    val height = min(available, SHOT_RAIL_VISIBLE * item + (SHOT_RAIL_VISIBLE - 1) * SHOT_RAIL_GAP)
+    return ShotRailFrame(x, top, width, height, item)
+}
+
+/** One-tap shot buttons on the live screen, hidden until a shot is saved. */
